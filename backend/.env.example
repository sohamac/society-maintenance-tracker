# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_tracker

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Overdue detection default (used only if a category has no sla_days override)
DEFAULT_SLA_DAYS=3

# Email (any free-tier SMTP works, e.g. Gmail with an App Password, or Mailtrap for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Society Maintenance <no-reply@society.local>"

# File upload
UPLOAD_DIR=src/uploads
MAX_UPLOAD_MB=5
